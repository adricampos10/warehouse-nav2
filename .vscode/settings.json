{
  // Python from the project's virtual environment (python3 -m venv .venv)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Testing panel: discover the pytest tests (configured in pytest.ini)
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Let Cmd+click resolve imports between scripts (metrics, worlds, nav_utils)
  "python.analysis.extraPaths": ["scripts"]
}
